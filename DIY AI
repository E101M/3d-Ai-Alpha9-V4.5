# 必須與訓練完全一致的字元集配置
CHARS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789(),[]={};+-*/._ "
VOCAB = ["<pad>", "<sos>", "<eos>", "<sep>", "<unk>"] + sorted(list(set(CHARS)))
VOCAB_SIZE = len(VOCAB)
MAX_LEN = 220

# =====================================================================
# 2. 載入網路結構 (與訓練完全一致，才能咬合權重矩陣)
# =====================================================================
class PositionalEncoding(nn.Module):
    def __init__(self, d_model, max_len=250):
        super().__init__()
        pe = torch.zeros(max_len, d_model)
        position = torch.arange(0, max_len, dtype=torch.float).unsqueeze(1)
        div_term = torch.exp(torch.arange(0, d_model, 2).float() * (-math.log(10000.0) / d_model))
        pe[:, 0::2] = torch.sin(position * div_term)
        pe[:, 1::2] = torch.cos(position * div_term)
        self.register_buffer('pe', pe.unsqueeze(0))
    def forward(self, x): return x + self.pe[:, :x.size(1)]

class Alpha9AtomicBrain(nn.Module):
    def __init__(self, vocab_size, d_model=384, nhead=12, num_layers=8, dim_feedforward=1536):
        super().__init__()
        self.embedding = nn.Embedding(vocab_size, d_model, padding_idx=0)
        self.pos_encoder = PositionalEncoding(d_model, MAX_LEN)
        encoder_layer = nn.TransformerEncoderLayer(
            d_model=d_model, nhead=nhead, dim_feedforward=dim_feedforward, 
            batch_first=True, activation='gelu', dropout=0.1, norm_first=True
        )
        self.transformer = nn.TransformerEncoder(encoder_layer, num_layers=num_layers)
        self.ln_f = nn.LayerNorm(d_model)
        self.fc_out = nn.Linear(d_model, vocab_size)

    def forward(self, x):
        sz = x.size(1)
        mask = torch.triu(torch.full((sz, sz), -1e4, device=x.device), diagonal=1)
        x = self.embedding(x)
        x = self.pos_encoder(x)
        out = self.transformer(x, mask=mask)
        out = self.ln_f(out)
        return self.fc_out(out)

# =====================================================================
# 3. 核心解碼引擎 (強行全輸出版本)
# =====================================================================
def generate_code_from_brain(brain, prompt_text, char2id, id2char, device):
    """ 驅動真正的神經網路進行自迴歸解碼 (強制全輸出除錯版) """
    brain.eval()
    input_text = f"<sos>{prompt_text}<sep>"
    input_ids = [char2id.get(c, char2id["<unk>"]) for c in input_text]
    
    generated_ids = list(input_ids)
    
    with torch.no_grad():
        for _ in range(120):  # 最大生成字元限制
            curr_tensor = torch.tensor([generated_ids], dtype=torch.long).to(device)
            outputs = brain(curr_tensor)
            next_token_logits = outputs[0, -1, :]
            next_token_id = torch.argmax(next_token_logits).item()
            
            if next_token_id == char2id["<eos>"] or next_token_id == 0:
                break
            generated_ids.append(next_token_id)
            
    full_output = "".join([id2char[i] for i in generated_ids])
    
    # 🚨 核心除錯錨點：強迫印出大腦完整的原始推導脈絡
    print("\n" + "=" * 65)
    print(f"📡 【Alpha-9 原始神經元信號】➔\n{full_output}")
    print("=" * 65 + "\n")
    
    return full_output

