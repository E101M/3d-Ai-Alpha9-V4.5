        print("❌ 錯誤：找不到訓練完成的權重檔案！請先運行 alpha9_v45_train.py 進行特訓。")
        return

    # 載入字符字典對照表
    char2id = {c: i for i, c in enumerate(VOCAB)}
    id2char = {i: c for i, c in enumerate(VOCAB)}
    
    # 初始化網路並精準咬合 .pth 權重檔
    brain = Alpha9AtomicBrain(vocab_size=VOCAB_SIZE).to(device)
    brain.load_state_dict(torch.load(str(BRAIN_PATH), map_location=device))
    print(f"🔥 實體權重檔案完美咬合！已成功驅動 14.2M 突觸算力。")
    print("💡 使用說明：輸入全新隨機數字的英文或代碼口令（輸入 'exit' 退出）")
    print("=" * 65)

    file_counter = 1
    while True:
        try:
            prompt = input("\n🛠️ 請輸入全新製程需求指令 ➔ ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\n👋 關閉 Alpha-9 核心。")
            break

        if prompt.lower() in ['exit', 'quit']:
            print("👋 關閉 Alpha-9 核心，釋放記憶體成功。")
            break
            
        if not prompt:
            continue
            
        print("🔮 核心矩陣運算中...")
        final_scad = generate_code_from_brain(brain, prompt, char2id, id2char, device)
        
        # 輸出實體 .scad 檔案
        file_name = f"alpha9_real_output_{file_counter}.scad"
        file_path = BASE_DIR / file_name
        
        try:
            with open(file_path, "w", encoding="utf-8") as f:
                f.write(final_scad)
            print(f"📁 實體檔案已儲存 ➔ {file_path}")
            file_counter += 1
        except Exception as e:
            print(f"❌ 檔案寫入失敗: {e}")

if __name__ == "__main__":
    main()
