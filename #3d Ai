# 4. 主控制台界面
# =====================================================================
def main():
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print("=" * 65)
    print("🧠 Alpha-9 v4.5 『真．神經網絡核心』工業推導主控台")

    if not BRAIN_PATH.exists() or not TOKENIZER_PATH.exists():
        print("❌ 錯誤：找不到訓練完成的權重檔案！")
        return

    char2id = {c: i for i, c in enumerate(VOCAB)}
    id2char = {i: c for i, c in enumerate(VOCAB)}

    brain = Alpha9AtomicBrain(vocab_size=VOCAB_SIZE).to(device)
    brain.load_state_dict(torch.load(str(BRAIN_PATH), map_location=device))
    print(f"🔥 實體權重檔案完美咬合！已成功驅動 14.2M 突觸算力。")
    print("💡 使用說明：輸入全新隨機數字的英文或代碼口令（輸入 'exit' 退出）")
    print("=" * 65)

    file_counter = 1
    while True:
        try:
            prompt = input("\n🛠️ 請輸入全新製程需求指令 ➔ ").strip()
        except (KeyboardInterrupt, EOFError):
            break
        if prompt.lower() in ['exit', 'quit']: break
        if not prompt: continue

        print("🔮 核心矩陣運算中...")
        clean_scad = generate_code_from_brain(brain, prompt, char2id, id2char, device)

        # 輸出純淨的實體 .scad 檔案
        file_name = f"alpha9_real_output_{file_counter}.scad"
        file_path = BASE_DIR / file_name

        try:
            with open(file_path, "w", encoding="utf-8") as f:
                f.write(f"// Alpha-9 Real AI Generated Model\n// Prompt: {prompt}\n\n")
                f.write(clean_scad)
            print(f"✨ [過濾後輸出結果]: {clean_scad}")
            print(f"📁 純淨實體檔案已儲存 ➔ {file_path}")
            file_counter += 1
        except Exception as e:
            print(f"❌ 檔案寫入失敗: {e}")


if __name__ == "__main__":
    main()
